# Copy to .env and fill in. .env is git-ignored and denied to the agents. Never commit a real key.
DEEPSEEK_API_KEY=

# Model names change over time. Confirm the current ones in the DeepSeek API docs.
# Agents that say "model: opus" use STRONG_MODEL; "model: sonnet" and "haiku" use FAST_MODEL.
STRONG_MODEL=deepseek-v4-pro
FAST_MODEL=deepseek-flash
